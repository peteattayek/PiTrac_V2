MIRA220_COMMIT=aeedd655d12f6698000416aa6fd94b6f4dfa7b16
MIRA220_MODULE=mira220
MIRA220_OVERLAY=mira220-nir
MIRA220_OVERLAY_SOURCE=dts/rpi/mira220-overlay.dts
TARGET_MODEL=Raspberry_Pi_5
TARGET_OS_CODENAME=trixie
TARGET_ARCH=aarch64
CANDIDATE_KERNEL_SERIES=6.18
CANDIDATE_KERNEL_FLAVOUR=rpi-2712
KERNEL_6_12_STATUS=unsupported_missing_vendor_APIs
KERNEL_6_18_STATUS=validated_6.18.50_specific_profile
OTHER_KERNELS_STATUS=unsupported_pending_separate_review
HARDWARE_VALIDATION=passed_60s_with_explicit_reduced_headroom
TARGET_BUILD_VALIDATION=passed
TARGET_INSTALL_VALIDATION=passed
SOURCE_COMPILED_KERNEL_RELEASE=6.18.50+rpt-rpi-2712
STREAMING_VALIDATION=dual_full_resolution_60s_passed
VALIDATED_KERNEL_RELEASE=6.18.50+rpt-rpi-2712
VALIDATED_MIRA220_PORT=CAM1
VALIDATED_IMX296_PORT=CAM0
VALIDATED_CAPTURE_BUFFERS=32
VALIDATED_WRITER_BUFFER_MIB_PER_CAMERA=128
VALIDATED_STORAGE_MIN_HEADROOM_PERCENT=20
VALIDATED_STORAGE_MEASURED_HEADROOM_PERCENT=24.319665

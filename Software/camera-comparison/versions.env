#
# Data, not shell code. Consumers must parse KEY=value, strip a trailing CR,
# validate expected keys/values, and never source/eval this file (CRLF-safe).
# Installer pins are also embedded in install-mira220.sh for standalone use.
MIRA220_REPOSITORY=https://github.com/ams-OSRAM/mira220_v4l2_driver.git
MIRA220_COMMIT=aeedd655d12f6698000416aa6fd94b6f4dfa7b16
MIRA220_MODULE=mira220
MIRA220_OVERLAY=mira220-nir
MIRA220_OVERLAY_SOURCE=dts/rpi/mira220-overlay.dts
TARGET_MODEL=Raspberry_Pi_5
TARGET_OS_CODENAME=trixie
TARGET_ARCH=aarch64
CANDIDATE_KERNEL_SERIES=6.18
CANDIDATE_KERNEL_FLAVOUR=rpi-2712
KERNEL_6_12_STATUS=unsupported_missing_vendor_APIs
KERNEL_6_18_STATUS=source_inspected_candidate_not_target_built
OTHER_KERNELS_STATUS=unsupported_pending_separate_review
HARDWARE_VALIDATION=pending
TARGET_BUILD_VALIDATION=pending
STREAMING_VALIDATION=pending_public_Pi5_CFE_issue_2_unresolved
VALIDATED_KERNEL_RELEASE=none
# Makefile builds ONLY mira220.ko. Compile the paired DTS separately with dtc;
# retain mira220.dtsi, local fixups/symbols (-@), and the vendor cam0 override.
# https://github.com/ams-OSRAM/mira220_v4l2_driver/tree/aeedd655d12f6698000416aa6fd94b6f4dfa7b16
# https://github.com/ams-OSRAM/mira220_v4l2_driver/issues/2

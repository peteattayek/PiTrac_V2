; SPDX-License-Identifier: GPL-3.0-or-later
; Copyright (C) 2026 PiTrac contributors
;
; strobe_burst.pio -- Phase 6 burst engine for PIO0 SM0, driving GPIO25 (Strobe_Pulse).
;
; LOADED by strobe.c since 2026-10-02 (6a/6b dry tests; live current 6c/6d since
; 2026-10-07). Before that it was assembled on every build but nothing loaded it.
;
; Written ahead of its phase because the program itself is measurement-independent
; -- only the *schedule* fed to it depends on the clamp width measured in 6a.
;
; 2026-08-28: adding it to the build immediately caught a UTF-8 BOM and mojibaked
; punctuation that pioasm rejects outright. It had been unbuildable since the day
; it was written, and would have failed on Phase 6's first build instead of here.
;
; ---------------------------------------------------------------------------
; Contract
; ---------------------------------------------------------------------------
; The state machine consumes a stream of 32-bit words from the TX FIFO, DMA-fed:
;
;     width_0, gap_0, width_1, gap_1, ... , 0
;
; Each value is a duration in microseconds MINUS loop overhead (see below). A
; width of 0 is the sentinel that ends the burst, raises IRQ0, and blocks waiting
; for the next burst.
;
; Clock: divided to 1 MHz, so one `jmp x--` iteration is 1 us and durations are
; expressed directly in microseconds.
;
; ---------------------------------------------------------------------------
; What this program does NOT do, deliberately
; ---------------------------------------------------------------------------
; It does not enforce a maximum pulse width. That is U5's job -- a 74LVC1G123
; monostable in hardware, which clamps every high phase regardless of what the
; PIO, the DMA, or a crashed core ever asks for. Duplicating the limit here would
; create a second source of truth and tempt someone to "fix" the discrepancy by
; defeating the hardware one.
;
; Firmware limits normal pulses to STROBE_SW_MAX_US, under the hardware clamp,
; so the hardware watchdog is a backstop that never normally fires, not a routine
; part of pulse shaping. The one exception is the 6a.1 clamp measurement.
;
; ---------------------------------------------------------------------------
; Timing note
; ---------------------------------------------------------------------------
; Each loop iteration is 1 cycle (1 us). Counted from the listing below, a width
; word N gives N + 2 us high and a gap word M gives M + 8 us low; IRQ0 is raised
; 8 us after the last falling edge. Those overheads are subtracted on the host --
; STROBE_PIO_WIDTH_OVERHEAD_US / STROBE_PIO_GAP_OVERHEAD_US in strobe_plan.h.
; Derived from the listing, then confirmed on board 1's logic analyser in 6a.2
; (2026-10-06): every width and period matched, so no correction.
;

.program strobe_burst

start:
    pull block              ; width in us; 0 ends the burst
    mov x, osr
    jmp !x done

    set pins, 1             ; ---- pulse high ----
hi:
    jmp x-- hi

    set pins, 0             ; ---- pulse low ----
    pull block              ; gap in us
    mov y, osr
lo:
    jmp y-- lo

    jmp start

done:
    irq set 0               ; burst complete; strobe.c polls this flag
    jmp start               ; block on pull, waiting for the next burst


% c-sdk {
#include "hardware/clocks.h"

// Configure SM `sm` on `pio` for `pin` at exactly 1 MHz (1 us per loop iteration).
//
// Does NOT take the pad. The pad stays wherever the caller left it -- strobe.c
// keeps GPIO25 SIO driven low and hands it to PIO only for an admitted burst,
// after setting this SM's output latch low and its direction to output. (This
// helper used to call pio_gpio_init() and set the direction before the level,
// leaving a window in which the pad was PIO-owned with an unset output value.)
static inline void strobe_burst_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = strobe_burst_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);

    // 150 MHz / 1 MHz = 150 exactly. An integer divider means no fractional
    // jitter on the pulse edges; refuse to run on a clock where that fails.
    uint32_t sysclk = clock_get_hz(clk_sys);
    uint32_t div    = sysclk / 1000000u;
    hard_assert(div * 1000000u == sysclk);
    sm_config_set_clkdiv(&c, (float)div);

    // All 32 bits out, no autopull -- `pull block` is explicit so the sentinel
    // and the FIFO-empty stall are both well defined.
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);   // deeper TX FIFO, 8 words

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, false);
}
%}

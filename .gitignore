# PiTrac V2
#
# LOCATION-INDEPENDENT ON PURPOSE. Every pattern below either has no slash, or
# starts with **/, so it matches at any depth. This file behaves identically
# whether it sits at the repo root or inside Hardware/.
#
# (A pattern *containing* a slash — like `firmware/build/` — is anchored to the
# directory holding the .gitignore, and silently stops matching if the file moves.
# That is an easy way to leak build output or machine-local config into a repo.)

# ---------------------------------------------------------------------------
# Build output — regenerated by cmake
# ---------------------------------------------------------------------------
build/

# Binaries. Attach to GitHub Releases instead of committing every flash cycle.
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map

# ---------------------------------------------------------------------------
# Editor / IDE state — MACHINE SPECIFIC, never commit
# ---------------------------------------------------------------------------
# The Raspberry Pi Pico extension writes absolute paths to ~/.pico-sdk into
# .vscode/settings.json. Committing it breaks the build for everyone else.
.vscode/
.idea/
*.code-workspace

# VS Code "Local History" extension. Contains its OWN nested .git repo, which
# makes `git add` fail outright with "does not have a commit checked out".
.history/

# Claude Code local tool permissions
settings.local.json

# ---------------------------------------------------------------------------
# KiCad
# ---------------------------------------------------------------------------
*-backups/
_autosave-*
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak

# Lock files — exist only while a document is open
*.lck
~*.*

# Per-user UI state: zoom, open sheets, visible layers. Not design data, and it
# churns on every open/close.
*.kicad_prl

# Rebuilt from libraries on demand
fp-info-cache

# Simulation scratch
*.raw

# ---------------------------------------------------------------------------
# Derived archives
# ---------------------------------------------------------------------------
# KiCad "Archive Project" zips duplicate tracked sources. To freeze a fab
# snapshot, tag the commit — that is what tags are for.
*.zip

# Exception: the gerbers actually sent to the fab ARE the authoritative record of
# what was physically manufactured. Keep them.
!**/jlcpcb/production_files/*.zip

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
